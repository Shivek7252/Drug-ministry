# Drug Ministry backend environment

# Required for AI verification (Mistral)
# Get a key at https://console.mistral.ai/
# Used for: chat completions (text reasoning) and Mistral OCR (scanned PDF fallback)
MISTRAL_API_KEY=your_mistral_api_key_here

# MongoDB connection string (defaults to local)
MONGODB_URI=mongodb://localhost:27017/drug_ministry
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_LIFETIME_MS=1800000
DEMO_APPLICANT_ID=replace-with-immutable-applicant-id
DEMO_APPLICANT_USERNAME=replace-with-applicant-username
DEMO_APPLICANT_PASSWORD_HASH=generate-with-npm-run-auth-hash-password
DEMO_REVIEWER_ID=replace-with-immutable-reviewer-id
DEMO_REVIEWER_USERNAME=replace-with-reviewer-username
DEMO_REVIEWER_PASSWORD_HASH=generate-with-npm-run-auth-hash-password

# Optional: override port
# PORT=5001
